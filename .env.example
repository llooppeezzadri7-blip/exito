# See ENVIRONMENT.md for full details on each variable.

# --- Supabase (required for real data; app falls back to mock data without it) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional integrations (each independently activates a feature) ---
GOOGLE_PAGESPEED_API_KEY=
ANTHROPIC_API_KEY=
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
N8N_WEBHOOK_URL=

# --- Autonomy (FASE 5): unattended cycles that keep what they learn ---
# The account autonomous work is attributed to. Without it, memory is
# process-local and lost on restart.
AUTONOMOUS_OWNER_ID=
# Shared secret for POST /api/autonomous/cycle (min. 16 chars). Without it the
# endpoint stays closed.
AUTONOMOUS_CYCLE_SECRET=

# --- Internal ---
# DATA_PROVIDER=mock
