# See ENVIRONMENT.md for full details on each variable.

# --- Supabase (required for real data; app falls back to mock data without it) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional integrations (each independently activates a feature) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
ANTHROPIC_API_KEY=
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
N8N_WEBHOOK_URL=

# --- Apuestas deportivas ---
# Sin ODDS_API_KEY el dashboard de /apuestas funciona con datos DEMO, marcados
# como tales en cada fila. Clave gratuita en https://the-odds-api.com
ODDS_API_KEY=
# Región de casas de apuestas: eu (incluye España), uk, us, au. Por defecto: eu
ODDS_API_REGION=

# --- Internal ---
# DATA_PROVIDER=mock
