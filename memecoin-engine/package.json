{
  "name": "memecoin-intelligence-engine",
  "version": "0.1.0",
  "private": true,
  "description": "24/7 memecoin research & risk-filtering engine (Solana first). Read-only, paper trading only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:api": "node dist/api-main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate-cli.ts",
    "check:sources": "tsx src/tools/check-sources.ts",
    "paper:stats": "tsx src/tools/paper-stats.ts",
    "replay": "tsx src/tools/replay.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
